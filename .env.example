# 生图供应商凭据（推荐方式：复制为 .env 并填自己的 key）
#
# 支持任何 OpenAI 兼容的 /v1/images/generations 接口
#
BIDVIZ_BASE_URL=https://api.yoshub.com
BIDVIZ_API_KEY=sk-your-key-here

# 可选：覆盖 bidviz.toml 里的默认值
# BIDVIZ_PROVIDER=grokimg
# BIDVIZ_MODEL=gpt-image-2-2K/4K
# BIDVIZ_SIZE=2048x1448
# BIDVIZ_PROJECT=projects/anke-35kv
