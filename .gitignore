# Python
__pycache__/
*.py[cod]
*.egg-info/
_*verify*.pdf
_smoke*.pdf
.venv/
venv/
.pip-cache/

# 密钥
.env
providers.toml

# 项目数据（体积大，不入库；只保留配置与输入）
# 注意：work/ 与 output/ 用 /* 形式忽略，以便下方白名单放行决策件与签认产物
projects/*/work/*
projects/*/output/*
projects/*/inputs/*
!projects/*/inputs/.gitkeep

# 决策件白名单（人工决断/签认产物，不可再生，必须入库）
!projects/*/work/page-plan.json
!projects/*/work/frozen.json
!projects/*/work/issues.json
!projects/*/work/figure-plan.json
!projects/*/work/edits.json
!projects/*/work/source-tables.json
!projects/*/work/source-assets.json
!projects/*/work/layout-classification.json
!projects/*/work/classification.md

# 临时
_vectest/
_*.png
_*.pdf
*.log
~$*
.DS_Store
Thumbs.db
/audit-layout.json
/audit-vector.json

# 本地工具状态（机器本地，不入库）
.mimosa/
.playwright-mcp/
.zcode/
/work/
projects/*/work/runs/
projects/*/work/memory-index*.sqlite3

# golden page 签认产物白名单（签认点②冻结件；必须放在 _*.png/_*.pdf 之后，最后匹配获胜）
!projects/*/output/_样板-S003.pdf
!projects/*/output/_样板-S003-contact-sheet.png
!projects/*/output/audit-layout-S003.json

# archify 本地产物（图与凭据）
.archify/

# memory 跨进程文件锁（瞬态运行时产物，不入库）
memory/**/*.lock
projects/*/memory/**/*.lock
